#!/usr/bin/env bash
# Runs niri's upstream CI checks on this host, against the working tree it is invoked in.
#
# It mirrors `.github/workflows/ci.yml` as read on upstream main at a8562a11 (2026-10-30). Every CI
# step that can run here is one gate step running the same command. The v26.04 ci.yml has the same
# steps; only the msrv toolchain differs, and the gate reads that from the tree's own ci.yml.
#
# No single dev environment runs every step on this host, so each step names one:
#
# - `upstream`: the tree's own flake dev shell (`nix develop <tree>`), with upstream's nightly
#   toolchain. rustfmt.toml needs a nightly rustfmt, and the shell has libadwaita for
#   niri-visual-tests. Its EGL tests fail here, though: the shell's older nixpkgs glibc/libglvnd
#   can't load the host's Mesa from /run/opengl-driver ("Unable to obtain a valid EGL Display").
#   So it runs rustfmt, clippy, the visual-tests build and the Fedora `cargo build --all`.
# - `msrv`: the `upstream` shell with the MSRV toolchain from the same flake's rust-overlay input
#   first on PATH.
# - `nixpkgs`: the build environment of nixpkgs' own niri package, from the nixpkgs that ~/nixos
#   locks (`nix develop --inputs-from ~/nixos nixpkgs#niri`, stable rustc). The deployed fork is
#   built with this recipe, and EGL works here with no extra setup. It runs the tests, the
#   randomized tests and the feature-combination builds. It has no libadwaita, so it can't build
#   niri-visual-tests. Set FORK_GATE_NIXPKGS_FROM to take nixpkgs from another flake.
# - `host`: no dev shell, for `nix flake check`.
#
# Each environment has its own CARGO_TARGET_DIR under the git-ignored target/: target/ (upstream),
# target/msrv and target/nixpkgs. Every step gets a private XDG_RUNTIME_DIR, so the compositor the
# tests start never shares a runtime directory with the live session.
#
# Not mirrored: the `freebsd` job (needs a FreeBSD VM), the Alpine container of `build-musl` (its
# cargo command runs on glibc here), the deploy-only `build-docs`/`publish-*` jobs and release.yml.
# `nix flake check` is advisory, as in CI (`continue-on-error: true`).
#
# Usage: .fork/gate [--list] [STEP...]
#
# With no STEP, runs every step. Logs go to target/gate/<step>.log. Exits 0 when every step passed,
# 1 when any failed, 2 on a usage or environment error.

set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
nixpkgs_from=${FORK_GATE_NIXPKGS_FROM:-$HOME/nixos}
log_dir=$root/target/gate

# The randomized-tests job's environment.
slow_env="env RUST_BACKTRACE=1 RUN_SLOW_TESTS=1 PROPTEST_CASES=200000"
slow_env+=" PROPTEST_MAX_LOCAL_REJECTS=200000 PROPTEST_MAX_GLOBAL_REJECTS=200000"
slow_env+=" PROPTEST_MAX_SHRINK_ITERS=200000"

# The CI steps, in ci.yml order: name, environment, target dir, command.
steps=(
  "test:build-tests|nixpkgs|target/nixpkgs|cargo test --no-run --all --exclude niri-visual-tests"
  "test:test|nixpkgs|target/nixpkgs|cargo test --all --exclude niri-visual-tests -- --nocapture"
  "build:no-default-features|nixpkgs|target/nixpkgs|cargo check --no-default-features"
  "build:dbus|nixpkgs|target/nixpkgs|cargo check --no-default-features --features dbus"
  "build:systemd|nixpkgs|target/nixpkgs|cargo check --no-default-features --features systemd"
  "build:dinit|nixpkgs|target/nixpkgs|cargo check --no-default-features --features dinit"
  "build:xdp-gnome-screencast|nixpkgs|target/nixpkgs|cargo check --no-default-features --features xdp-gnome-screencast"
  "build:check|nixpkgs|target/nixpkgs|cargo check"
  "build:profile-with-tracy|nixpkgs|target/nixpkgs|cargo build --features profile-with-tracy"
  "build-musl:build|nixpkgs|target/nixpkgs|cargo build --no-default-features --features dbus,xdp-gnome-screencast"
  "randomized-tests:build-tests|nixpkgs|target/nixpkgs|$slow_env cargo test --no-run --all --exclude niri-visual-tests --release"
  "randomized-tests:test|nixpkgs|target/nixpkgs|$slow_env cargo test --all --exclude niri-visual-tests --release"
  "visual-tests:build|upstream|target|cargo build --package niri-visual-tests"
  "msrv:check|msrv|target/msrv|cargo check --all-targets"
  "clippy:clippy|upstream|target|cargo clippy --all --all-targets"
  "rustfmt:rustfmt|upstream|target|cargo fmt --all -- --check"
  "fedora:build|upstream|target|cargo build --all"
  "freebsd:build|skip|-|needs a FreeBSD VM"
  "nix:flake-check|host|-|nix flake check"
)

list_steps() {
  local s name env target cmd
  for s in "${steps[@]}"; do
    IFS='|' read -r name env target cmd <<<"$s"
    printf '%-30s %-9s %s\n' "$name" "$env" "$cmd"
  done
}

selected=()
for arg in "$@"; do
  case $arg in
    --list) list_steps; exit 0 ;;
    -h | --help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) echo "gate: unknown option $arg" >&2; exit 2 ;;
    *)
      known=0
      for s in "${steps[@]}"; do [[ ${s%%|*} == "$arg" ]] && known=1; done
      ((known)) || { echo "gate: unknown step $arg (see --list)" >&2; exit 2; }
      selected+=("$arg")
      ;;
  esac
done

is_selected() {
  local s
  ((${#selected[@]} == 0)) && return 0
  for s in "${selected[@]}"; do [[ $s == "$1" ]] && return 0; done
  return 1
}

command -v nix >/dev/null || { echo "gate: nix not found" >&2; exit 2; }
[[ -e $nixpkgs_from/flake.nix ]] || {
  echo "gate: no flake at $nixpkgs_from (set FORK_GATE_NIXPKGS_FROM)" >&2
  exit 2
}

# The msrv job pins its toolchain as `dtolnay/rust-toolchain@<version>`.
msrv_version() {
  awk '/^  [a-z-]+:$/ { job = $1 } job == "msrv:" && /dtolnay\/rust-toolchain@/ {
    sub(/.*@/, ""); print; exit }' .github/workflows/ci.yml
}

msrv_toolchain=
resolve_msrv_toolchain() {
  local version
  version=$(msrv_version)
  [[ -n $version ]] || { echo "gate: no msrv toolchain in ci.yml" >&2; return 1; }
  echo "msrv toolchain: rust $version (rust-overlay#rust_${version//./_})"
  msrv_toolchain=$(nix build --no-link --print-out-paths --inputs-from "$root" \
    "rust-overlay#rust_${version//./_}")
}

run_dir=$(mktemp -d -t niri-gate-run.XXXXXX)
trap 'rm -rf "$run_dir"' EXIT

# Runs a command in one of the environments, with the step's target dir. Logs the toolchain first.
run_in() {
  local env=$1 target=$2
  shift 2
  local vars=(XDG_RUNTIME_DIR="$run_dir") shell path_prefix=
  [[ $target != - ]] && vars+=(CARGO_TARGET_DIR="$root/$target")
  case $env in
    upstream) shell=(nix develop "$root") ;;
    msrv)
      resolve_msrv_toolchain || return 1
      shell=(nix develop "$root")
      path_prefix=$msrv_toolchain/bin
      ;;
    nixpkgs) shell=(nix develop --inputs-from "$nixpkgs_from" nixpkgs#niri) ;;
    host)
      env "${vars[@]}" "$@"
      return
      ;;
  esac
  # shellcheck disable=SC2016 # expanded by the inner shell
  "${shell[@]}" --command bash -c '
    [[ -n $1 ]] && export PATH="$1:$PATH"
    shift
    echo "toolchain: $(rustc --version); $(cargo --version)"
    echo
    exec "$@"' gate "$path_prefix" env "${vars[@]}" "$@"
}

mkdir -p "$log_dir"
head=$(git rev-parse HEAD)
dirty=clean
[[ -n $(git status --porcelain) ]] && dirty=dirty
echo "gate: $root at $head ($dirty)"

summary=()
failed=()
advisory_failed=0
ran=0
gate_start=$SECONDS
for s in "${steps[@]}"; do
  IFS='|' read -r name env target cmd <<<"$s"
  is_selected "$name" || continue
  if [[ $env == skip ]]; then
    summary+=("$(printf 'SKIP  %-30s %6s  %s' "$name" "" "$cmd")")
    continue
  fi
  read -ra argv <<<"$cmd"
  [[ $name == nix:flake-check ]] && argv+=("$root")
  log=$log_dir/${name//:/_}.log
  echo "==> $name [$env] ${argv[*]}"
  start=$SECONDS
  rc=0
  {
    echo "step: $name"
    echo "env: $env, target: $target"
    echo "command: ${argv[*]}"
    echo "tree: $root at $head ($dirty)"
    echo
    run_in "$env" "$target" "${argv[@]}"
  } >"$log" 2>&1 </dev/null || rc=$?
  took=$((SECONDS - start))
  ran=$((ran + 1))
  status=PASS
  if ((rc != 0)); then
    if [[ $name == nix:flake-check ]]; then
      status='FAIL*'
      advisory_failed=1
    else
      status=FAIL
      failed+=("$name")
    fi
    tail -n 40 "$log" | sed 's/^/    /'
  fi
  echo "    $status in ${took}s (exit $rc, log ${log#"$root"/})"
  summary+=("$(printf '%-5s %-30s %5ss  [%s] %s' "$status" "$name" "$took" "$env" "${argv[*]}")")
done

echo
echo "== gate summary: $root at $head ($dirty)"
printf '%s\n' "${summary[@]}"
((advisory_failed)) && echo "(FAIL* is advisory: continue-on-error in CI)"
total=$((SECONDS - gate_start))
if ((${#failed[@]} > 0)); then
  echo "gate: FAIL (${#failed[@]} of $ran steps: ${failed[*]}) in ${total}s"
  exit 1
fi
echo "gate: PASS ($ran steps) in ${total}s"
